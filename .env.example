# Server-side MongoDB connection and database.
MONGODB_URI=
MONGODB_DATABASE=cognify

# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Used by the existing legacy document upload/OCR workflow only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenParser hosted OCR. Keep the API key server-side; never use NEXT_PUBLIC_ here.
OPENPARSER_API_KEY=
OPENPARSER_BASE_URL=https://api.openparser.dev
OPENPARSER_OCR_MODEL=paddleocr-vl-1.6
OPENPARSER_LLM_MODEL=openai/gpt-6-luna
OPENPARSER_TIMEOUT_SECONDS=45
OPENPARSER_POLL_INTERVAL_MS=3000
MATERIAL_MAX_FILES=8
MATERIAL_MAX_FILE_SIZE=10485760
MATERIAL_MAX_BATCH_SIZE=52428800

